@page "/watches"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using System.Text.Json
@using System.Text.Json.Serialization
@using WatchThisForMe.Core.Watches
@inject ApiClient Api

<PageTitle>Watches</PageTitle>

<h1>My Watches</h1>
<p class="text-muted mb-4">
    Your agent checks each source on schedule and flags only the changes that need interpreting:
    a new release, a security fix, an earnings announcement. It skips routine edits like a reworded
    sentence or a new date in the footer.
</p>

<div class="mb-4">
    <label class="form-label">Describe what you want to watch</label>
    <textarea class="form-control" rows="2" @bind="naturalLanguageRequest"
              placeholder="e.g. Watch the dotnet/runtime releases and tell me only about breaking changes or security fixes"></textarea>
    <button class="btn btn-primary mt-2" @onclick="CreateFromNaturalLanguage" disabled="@isCreating">
        @(isCreating ? "Creating..." : "Create Watch")
    </button>
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <p class="text-danger mt-2">@errorMessage</p>
    }
</div>

@if (serviceProblem is not null)
{
    <div class="alert alert-warning d-flex justify-content-between align-items-center" role="alert">
        <div>
            <strong>@serviceProblem</strong>
            <div class="small">Your watches are safe. Anything that changes in the meantime will be picked up once the service is back.</div>
        </div>
        <button class="btn btn-sm btn-outline-dark ms-3" @onclick="LoadSummariesAsync">Try again</button>
    </div>
}

@if (summaries is null)
{
    @if (serviceProblem is null)
    {
        <p>Loading...</p>
    }
}
else if (summaries.Count == 0)
{
    <p class="text-muted">No watches yet. Describe one above to get started.</p>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-2">
        <span class="text-muted small">@HealthCountsText()</span>
        <button class="btn btn-sm btn-outline-secondary" @onclick="LoadSummariesAsync">Refresh</button>
    </div>

    <table class="table align-middle watch-table">
        <thead>
            <tr>
                <th>Health</th>
                <th>Watch</th>
                <th>Checks</th>
                <th>Last checked</th>
                <th>Last important change</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var summary in summaries)
            {
                var watch = summary.Watch;
                <tr>
                    <td>
                        <span class="health-badge @HealthCss(summary.Health)" title="@summary.LastError">
                            @HealthIcon(summary.Health) @HealthLabel(summary.Health)
                        </span>
                        @if (summary.LastError is not null)
                        {
                            <div class="small text-danger error-line" title="@summary.LastError">@summary.LastError</div>
                        }
                    </td>
                    <td>
                        <div class="fw-semibold">@watch.Name</div>
                        <div class="small text-muted text-truncate source-line" title="@watch.Source">@watch.SourceType · @watch.Source</div>
                    </td>
                    <td class="text-nowrap">@FormatFrequency(watch.CheckFrequency)</td>
                    <td class="text-nowrap" title="@watch.LastCheckedAt?.ToLocalTime().ToString("g")">
                        @FormatRelative(watch.LastCheckedAt, "Never")
                    </td>
                    <td>
                        @if (summary.LastImportantChangeAt is not null)
                        {
                            <div>
                                @if (!string.IsNullOrEmpty(summary.LastImportantChangeCategory))
                                {
                                    <span class="badge text-bg-info me-1">@FormatCategory(summary.LastImportantChangeCategory)</span>
                                }
                                <span class="small text-muted">@FormatRelative(summary.LastImportantChangeAt, "")</span>
                            </div>
                            <div class="small change-summary" title="@summary.LastImportantChangeSummary">@summary.LastImportantChangeSummary</div>
                        }
                        else
                        {
                            <span class="small text-muted">
                                @(summary.LastChangeAt is null ? "No changes yet" : "No important changes recently")
                            </span>
                        }
                    </td>
                    <td class="text-nowrap text-end">
                        @if (watch.Status == WatchStatus.Active)
                        {
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => CheckNow(watch.Id)"
                                    disabled="@checkingIds.Contains(watch.Id)">
                                @(checkingIds.Contains(watch.Id) ? "Checking..." : "Check now")
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-success" @onclick="() => Resume(watch.Id)"
                                    disabled="@checkingIds.Contains(watch.Id)"
                                    title="Switch this watch back on and check it straight away">
                                @(checkingIds.Contains(watch.Id) ? "Resuming..." : "Resume")
                            </button>
                        }
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => StartEdit(watch)">Edit</button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteWatch(watch.Id)">Delete</button>
                    </td>
                </tr>
                @if (editingId == watch.Id)
                {
                    <tr class="edit-row">
                        <td colspan="6">
                            <div class="row g-2">
                                <div class="col-md-4">
                                    <label class="form-label small mb-0">Name</label>
                                    <input class="form-control form-control-sm" @bind="editName" />
                                </div>
                                <div class="col-md-8">
                                    <label class="form-label small mb-0">Address</label>
                                    <input class="form-control form-control-sm" @bind="editSource" />
                                    @if (watch.RedirectedTo is { } newAddress && editSource != newAddress)
                                    {
                                        <button class="btn btn-link btn-sm p-0" @onclick="() => editSource = newAddress">
                                            Use the address it now redirects to
                                        </button>
                                    }
                                </div>
                                <div class="col-12">
                                    <label class="form-label small mb-0">What counts as a meaningful change</label>
                                    <textarea class="form-control form-control-sm" rows="2" @bind="editCriteria"></textarea>
                                </div>
                            </div>
                            <div class="small text-muted mt-1">
                                Changing the address starts fresh: the new page becomes the starting point for spotting changes.
                            </div>
                            @if (editError is not null)
                            {
                                <div class="small text-danger mt-1">@editError</div>
                            }
                            <div class="mt-2">
                                <button class="btn btn-sm btn-primary" @onclick="() => SaveEdit(watch)" disabled="@isSaving">
                                    @(isSaving ? "Saving..." : "Save")
                                </button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="CancelEdit" disabled="@isSaving">Cancel</button>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
}

@code {
    private static readonly JsonSerializerOptions JsonOptions = new()
    {
        PropertyNameCaseInsensitive = true,
        Converters = { new JsonStringEnumConverter() }
    };

    private List<WatchSummary>? summaries;
    private readonly HashSet<string> checkingIds = [];
    private string naturalLanguageRequest = string.Empty;
    private bool isCreating;
    private string? errorMessage;

    // Set when the Api can't be reached or errors; shown as a banner instead of a crash page.
    // The last successfully loaded list stays on screen underneath it.
    private string? serviceProblem;

    protected override async Task OnInitializedAsync()
    {
        await LoadSummariesAsync();
    }

    // Runs one Api interaction, turning "Api down" or "Api errored" into a friendly banner.
    // Deliberately catches only HTTP failures and timeouts: ApiClient signals "user must sign
    // in again" with a different exception, which has to propagate to trigger the redirect.
    private async Task<bool> CallApiAsync(Func<HttpClient, Task> action)
    {
        try
        {
            var client = await Api.CreateAsync();
            await action(client);
            return true;
        }
        catch (HttpRequestException ex)
        {
            serviceProblem = ex.StatusCode is null
                ? "We can't reach the monitoring service right now."
                : "The monitoring service ran into a problem.";
            return false;
        }
        catch (TaskCanceledException)
        {
            serviceProblem = "The monitoring service is taking too long to respond.";
            return false;
        }
    }

    private async Task LoadSummariesAsync()
    {
        if (await CallApiAsync(async client =>
                summaries = await client.GetFromJsonAsync<List<WatchSummary>>("api/watches/summaries", JsonOptions) ?? []))
        {
            serviceProblem = null;
        }
    }

    private async Task CreateFromNaturalLanguage()
    {
        if (string.IsNullOrWhiteSpace(naturalLanguageRequest))
        {
            return;
        }

        isCreating = true;
        errorMessage = null;

        try
        {
            HttpResponseMessage? response = null;
            if (!await CallApiAsync(async client =>
                    response = await client.PostAsJsonAsync("api/watches/from-natural-language", new { request = naturalLanguageRequest })))
            {
                return;
            }

            if (response!.IsSuccessStatusCode)
            {
                naturalLanguageRequest = string.Empty;
                await LoadSummariesAsync();
            }
            else
            {
                errorMessage = "Couldn't create that watch. Try describing the source more specifically (e.g. a repo name or URL), or try again in a moment.";
            }
        }
        finally
        {
            isCreating = false;
        }
    }

    private async Task CheckNow(string id)
    {
        checkingIds.Add(id);
        errorMessage = null;
        try
        {
            HttpResponseMessage? response = null;
            if (await CallApiAsync(async client => response = await client.PostAsync($"api/watches/{id}/check", null))
                && !response!.IsSuccessStatusCode)
            {
                // The failure itself is recorded as a run, so the refreshed row shows the actual reason.
                errorMessage = "The check didn't succeed. See the watch's row for the reason.";
            }
        }
        finally
        {
            checkingIds.Remove(id);
        }

        if (serviceProblem is null)
        {
            await LoadSummariesAsync();
        }
    }

    // Switch the watch back on, then check it straight away so the user sees at once whether
    // the source has recovered (if it hasn't, the row shows the error and it retries on schedule).
    private async Task Resume(string id)
    {
        checkingIds.Add(id);
        errorMessage = null;
        try
        {
            HttpResponseMessage? response = null;
            if (!await CallApiAsync(async client => response = await client.PostAsync($"api/watches/{id}/resume", null)))
            {
                return;
            }

            if (!response!.IsSuccessStatusCode)
            {
                errorMessage = "Couldn't resume that watch. Please try again.";
                return;
            }
        }
        finally
        {
            checkingIds.Remove(id);
        }

        await CheckNow(id);
    }

    // ---- Editing a watch (name, address, what counts as meaningful) ----

    private string? editingId;
    private string editName = string.Empty;
    private string editSource = string.Empty;
    private string editCriteria = string.Empty;
    private string? editError;
    private bool isSaving;

    private void StartEdit(Watch watch)
    {
        editingId = watch.Id;
        editName = watch.Name;
        editSource = watch.Source;
        editCriteria = watch.MeaningfulChangeCriteria;
        editError = null;
    }

    private void CancelEdit() => editingId = null;

    private async Task SaveEdit(Watch original)
    {
        editError = ValidateEdit(original.SourceType);
        if (editError is not null)
        {
            return;
        }

        var addressChanged = editSource.Trim() != original.Source;
        Watch? updated = null;
        HttpResponseMessage? response = null;

        isSaving = true;
        try
        {
            // Start from the latest copy so fields this form doesn't show are sent back unchanged.
            if (!await CallApiAsync(async client =>
                {
                    updated = await client.GetFromJsonAsync<Watch>($"api/watches/{original.Id}", JsonOptions);
                    if (updated is null)
                    {
                        return;
                    }

                    updated.Name = editName.Trim();
                    updated.Source = editSource.Trim();
                    updated.MeaningfulChangeCriteria = editCriteria.Trim();
                    response = await client.PutAsJsonAsync($"api/watches/{original.Id}", updated, JsonOptions);
                }))
            {
                return;
            }

            if (response is null || !response.IsSuccessStatusCode)
            {
                editError = "Couldn't save the changes. Please try again.";
                return;
            }
        }
        finally
        {
            isSaving = false;
        }

        editingId = null;

        // A new address on a stopped watch is almost always the fix for why it stopped, so switch
        // it back on; either way, check straight away so the user sees whether the new address works.
        if (addressChanged && updated!.Status == WatchStatus.DeadLettered)
        {
            await Resume(original.Id);
        }
        else if (addressChanged && updated!.Status == WatchStatus.Active)
        {
            await CheckNow(original.Id);
        }
        else
        {
            await LoadSummariesAsync();
        }
    }

    private string? ValidateEdit(SourceType sourceType)
    {
        if (string.IsNullOrWhiteSpace(editName))
        {
            return "Give the watch a name.";
        }

        if (string.IsNullOrWhiteSpace(editCriteria))
        {
            return "Describe what counts as a meaningful change, so the agent knows what to flag.";
        }

        if (sourceType == SourceType.WebPage
            && !(Uri.TryCreate(editSource.Trim(), UriKind.Absolute, out var uri) && (uri.Scheme == Uri.UriSchemeHttps || uri.Scheme == Uri.UriSchemeHttp)))
        {
            return "The address must be a full web address starting with https://";
        }

        return string.IsNullOrWhiteSpace(editSource) ? "Enter the address to watch." : null;
    }

    private async Task DeleteWatch(string id)
    {
        if (await CallApiAsync(client => client.DeleteAsync($"api/watches/{id}")))
        {
            await LoadSummariesAsync();
        }
    }

    private string HealthCountsText()
    {
        var healthy = summaries!.Count(s => s.Health == WatchHealth.Healthy);
        var attention = summaries!.Count(s => s.Health is WatchHealth.NeedsAttention or WatchHealth.Stopped);
        var text = $"{summaries!.Count} watches · {healthy} healthy";
        return attention > 0 ? $"{text} · {attention} need attention" : text;
    }

    private static string HealthIcon(WatchHealth health) => health switch
    {
        WatchHealth.Healthy => "🟢",
        WatchHealth.NeedsAttention => "🟡",
        WatchHealth.Stopped => "🔴",
        WatchHealth.Paused => "⏸",
        _ => "⚪"
    };

    private static string HealthLabel(WatchHealth health) => health switch
    {
        WatchHealth.Healthy => "Healthy",
        WatchHealth.NeedsAttention => "Needs attention",
        WatchHealth.Stopped => "Stopped",
        WatchHealth.Paused => "Paused",
        _ => "Waiting for first check"
    };

    private static string HealthCss(WatchHealth health) => health switch
    {
        WatchHealth.Healthy => "health-ok",
        WatchHealth.NeedsAttention => "health-warn",
        WatchHealth.Stopped => "health-bad",
        _ => "health-neutral"
    };

    private static string FormatFrequency(TimeSpan frequency) => frequency switch
    {
        { TotalDays: >= 1 } when frequency.TotalDays % 1 == 0 => frequency.TotalDays == 1 ? "Daily" : $"Every {frequency.TotalDays:0} days",
        { TotalHours: >= 1 } when frequency.TotalHours % 1 == 0 => frequency.TotalHours == 1 ? "Hourly" : $"Every {frequency.TotalHours:0} hours",
        _ => $"Every {frequency.TotalMinutes:0} min"
    };

    // Classifier categories are snake_case ("new_release") - show them as "New release".
    private static string FormatCategory(string category)
    {
        var words = category.Replace('_', ' ').Trim();
        return words.Length == 0 ? words : char.ToUpperInvariant(words[0]) + words[1..];
    }

    private static string FormatRelative(DateTimeOffset? when, string fallback)
    {
        if (when is null)
        {
            return fallback;
        }

        var ago = DateTimeOffset.UtcNow - when.Value;
        return ago switch
        {
            { TotalMinutes: < 1 } => "just now",
            { TotalHours: < 1 } => $"{(int)ago.TotalMinutes} min ago",
            { TotalDays: < 1 } => $"{(int)ago.TotalHours} h ago",
            { TotalDays: < 30 } => $"{(int)ago.TotalDays} d ago",
            _ => when.Value.ToLocalTime().ToString("d")
        };
    }
}
